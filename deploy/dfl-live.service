[Unit]
Description=Diamond Football League live runner (plays the league on the real clock for the website)
After=network.target

[Service]
User=dfl
Group=dfl
WorkingDirectory=/opt/dfl
Environment=TZ=America/Los_Angeles
ExecStart=/usr/bin/python3 -I /opt/dfl/engine/live.py --out /var/www/dfl/live
Restart=always
RestartSec=5
# The runner replays the league years already gone from the saved seed (about two seconds each) and then carries on from the clock.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/www/dfl/live
PrivateTmp=true

[Install]
WantedBy=multi-user.target
