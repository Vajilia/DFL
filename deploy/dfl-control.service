[Unit]
Description=Diamond Football League pause switch (the website's Pause / Resume button)
After=network.target

[Service]
User=dfl
Group=dfl
WorkingDirectory=/opt/dfl
ExecStart=/usr/bin/python3 -I /opt/dfl/engine/control_server.py --out /var/www/dfl/live --port 8081
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/www/dfl/live
PrivateTmp=true

[Install]
WantedBy=multi-user.target
